generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AuthProvider {
  PASSWORD
  PHONE
}

enum PointType {
  ORIGIN
  DESTINATION
  BOTH
}

enum PointCategory {
  RESIDENTIAL
  CENTER
  UNIVERSITY
  BUSINESS
  TRANSPORT
}

enum TripStatus {
  SCHEDULED
  PENDING_CONFIRMATION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_DRIVER
  CANCELLED_BY_PASSENGER
  UNCONFIRMED
  NO_SHOW
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum FeeStatus {
  PENDING
  PAID
  REFUNDED
}

enum ComplaintStatus {
  OPEN
  REVIEWING
  RESOLVED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String    @id @default(cuid())

  login           String?   @unique
  passwordHash    String?
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  authProvider    AuthProvider @default(PASSWORD)

  firstName       String
  lastName        String?
  bio             String?
  role            Role      @default(PASSENGER)
  status          UserStatus @default(ACTIVE)
  ratingAsDriver    Float   @default(5.0)
  ratingAsPassenger Float   @default(5.0)

  maxUsername       String?
  maxVerifiedAt     DateTime?
  maxVerifiedBy     String?

  referralCode    String?   @unique
  referredBy      String?

  createdAt       DateTime  @default(now())
  lastActiveAt    DateTime  @updatedAt

  @@index([referredBy])

  driverProfile    DriverProfile?
  routeTemplates   RouteTemplate[] @relation("Driver")
  tripsAsDriver    Trip[]          @relation("TripsAsDriver")
  bookings         Booking[]
  reviewsWritten   Review[]        @relation("Reviewer")
  reviewsReceived  Review[]        @relation("Reviewee")
  complaints       Complaint[]     @relation("Reporter")
  notifications    Notification[]
  demandRequests   DemandRequest[] @relation("DemandPassenger")
  pushSubscriptions PushSubscription[]
  chatMessages     ChatMessage[]
}

model DriverProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  carModel             String
  carNumber            String
  carColor             String?
  verificationStatus   VerificationStatus @default(NOT_SUBMITTED)
  licensePhotoUrl      String?
  carPhotoUrl          String?
  verifiedAt           DateTime?
  verificationComment  String?
  totalRides           Int                @default(0)
  createdAt            DateTime           @default(now())

  @@index([verificationStatus])
}

model CityPoint {
  id          String        @id @default(cuid())
  name        String        @unique
  lat         Float
  lng         Float
  type        PointType
  category    PointCategory
  description String?

  origins      RouteTemplate[] @relation("Origin")
  destinations RouteTemplate[] @relation("Destination")
  meetingPoints MeetingPoint[]
}

model MeetingPoint {
  id          String    @id @default(cuid())
  cityPointId String
  cityPoint   CityPoint @relation(fields: [cityPointId], references: [id], onDelete: Cascade)
  name        String
  lat         Float
  lng         Float
  landmark    String?
  instruction String?
  createdAt   DateTime  @default(now())
}

model RouteTemplate {
  id              String    @id @default(cuid())
  driverId        String
  driver          User      @relation("Driver", fields: [driverId], references: [id], onDelete: Cascade)

  originId        String
  origin          CityPoint @relation("Origin", fields: [originId], references: [id])
  originMeetingPointId  String?
  destId          String
  destination     CityPoint @relation("Destination", fields: [destId], references: [id])
  destMeetingPointId    String?

  departureTime   String
  timezone        String    @default("Asia/Tomsk")
  daysOfWeek      Int[]
  startDate       DateTime  @default(now())
  endDate         DateTime?

  seats           Int       @default(3)
  price           Int
  serviceFee      Int       @default(0)

  isRecurring     Boolean   @default(true)
  active          Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([driverId])
  @@index([active, isRecurring])

  trips           Trip[]
}

model Trip {
  id              String     @id @default(cuid())
  routeTemplateId String?
  routeTemplate   RouteTemplate? @relation(fields: [routeTemplateId], references: [id], onDelete: Cascade)

  /// Водитель поездки (самостоятельные поездки не привязаны к шаблону)
  driverId        String?
  driver          User?      @relation("TripsAsDriver", fields: [driverId], references: [id], onDelete: Cascade)

  /// Ссылки на остановки справочника Stop (Concept 2.1)
  originStopId    String?
  originStop      Stop?      @relation("TripOrigin", fields: [originStopId], references: [id])
  destStopId      String?
  destStop        Stop?      @relation("TripDest", fields: [destStopId], references: [id])
  /// Снимок маршрута и цены на момент публикации
  originName      String?
  destName        String?
  originLat       Float?
  originLng       Float?
  destLat         Float?
  destLng         Float?
  price           Int?
  seatsTotal      Int?
  comment         String?

  /// autoAccept: мгновенное подтверждение брони (true по умолчанию)
  autoAccept      Boolean    @default(true)

  /// Повтор: NONE / WEEKDAYS / DAILY
  repeatType      String     @default("NONE")
  repeatUntil     DateTime?
  parentTripId    String?
  parentTrip      Trip?      @relation("TripSeries", fields: [parentTripId], references: [id])
  childTrips      Trip[]     @relation("TripSeries")

  /// Снимок маршрута из реестра: упорядоченные остановки (JSONB)
  routeStops      Json?
  routeNumber     String?

  date            DateTime   @db.Date
  departureTime   DateTime
  status          TripStatus @default(SCHEDULED)

  availableSeats  Int

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  bookings        Booking[]
  demandMatchedTrip DemandRequest[] @relation("DemandMatchedTrip")
  chatMessages     ChatMessage[]

  @@index([date, status])
  @@index([status, departureTime])
  @@index([driverId, date])
  @@index([originStopId, destStopId])
}

model Booking {
  id                 String        @id @default(cuid())
  tripId             String
  trip               Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passengerId        String
  passenger          User          @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  status             BookingStatus @default(PENDING)

  compensationAmount Int
  serviceFeeAmount   Int
  totalAmount        Int
  serviceFeeStatus   FeeStatus     @default(PENDING)
  paymentReference   String?
  offerAccepted      Boolean       @default(false)

  /// autoAccepted: признак мгновенного подтверждения при создании
  autoAccepted       Boolean       @default(false)
  /// phonesVisibleAt: время открытия телефонов обеим сторонам
  phonesVisibleAt    DateTime?

  /// Дедлайн оплаты: до него место закреплено за пассажиром (Concept 2.1: не используется, сбор 0%)
  paymentDeadline    DateTime?
  cancelledAt        DateTime?
  cancelInitiator    String?

  /// segmentPrice: цена отрезка для этого бронирования
  segmentPrice       Int?

  distanceKm         Float?
  pricingVersion     String?

  /// Отрезок маршрута: снимок остановок посадки и высадки
  pickupStopId       String?
  dropoffStopId      String?
  pickupName         String?
  dropoffName        String?
  amountDue          Int?
  note               String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Одна активная бронь на (поездка, пассажир): partial unique index
  // "Booking_active_trip_passenger_key" ... WHERE status IN ('PENDING','CONFIRMED')
  // объявлен в миграции 20261013120000_booking_lifecycle_and_indexes.
  @@index([tripId, status])
  @@index([passengerId, status])
  @@index([paymentDeadline])

  review             Review?
  complaints         Complaint[]
}

model Review {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  reviewerId  String
  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId  String
  reviewee    User     @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)

  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  @@index([revieweeId])
}

model Complaint {
  id          String          @id @default(cuid())
  bookingId   String?
  booking     Booking?        @relation(fields: [bookingId], references: [id])
  reporterId  String
  reporter    User            @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  category    String
  description String
  status      ComplaintStatus @default(OPEN)
  createdAt   DateTime        @default(now())
  resolvedAt  DateTime?
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  title           String
  body            String
  read            Boolean  @default(false)
  relatedEntityId String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model DemandRequest {
  id          String    @id @default(cuid())
  passengerId String
  passenger   User      @relation("DemandPassenger", fields: [passengerId], references: [id], onDelete: Cascade)
  fromStopId  String
  fromStop    Stop      @relation("DemandFrom", fields: [fromStopId], references: [id])
  toStopId    String
  toStop      Stop      @relation("DemandTo", fields: [toStopId], references: [id])
  date        DateTime  @db.Date
  timeWindow  String?   // желаемое время в формате ЧЧ:ММ
  seats       Int       @default(1)
  status      String    @default("OPEN") // OPEN / MATCHED / CLOSED / EXPIRED
  matchedTripId String?
  matchedTrip   Trip?     @relation("DemandMatchedTrip", fields: [matchedTripId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([fromStopId, toStopId, date])
  @@index([status])
}

/// Остановки Томска: справочник из CSV (1263 записи), источник — data/tomsk-stops.csv.
/// Пользовательские точки маршрутов в будущем ссылаются на Stop.
model Stop {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String
  address        String?
  lat            Float
  lng            Float
  busRoutes      String?
  trolleyRoutes  String?
  tramRoutes     String?
  isPopular      Boolean  @default(false)
  isHub          Boolean  @default(false) // транспортный хаб для склейки маршрутов (Concept 2.1)
  createdAt      DateTime @default(now())

  tripOrigin     Trip[]     @relation("TripOrigin")
  tripDest       Trip[]     @relation("TripDest")
  demandFrom     DemandRequest[] @relation("DemandFrom")
  demandTo       DemandRequest[] @relation("DemandTo")

  @@index([nameNormalized])
  @@index([isPopular])
  @@index([isHub])
}

model ChatMessage {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([tripId, createdAt])
  @@index([senderId])
}

